name: 代理任務切片
description: 定義一個獨立可驗證的工作切片供指派。
title: "[代理任務] "
body:
  - type: textarea
    id: outcome
    attributes:
      label: 結果與驗收
      description: 描述產品結果及其驗證方式。
    validations:
      required: true
  - type: textarea
    id: handoff
    attributes:
      label: 機器可讀交接
      description: 一位擁有者宣告任務時替換佔位符。
      render: markdown
      value: |
        <!-- agent-workflow:handoff-v1
        {
          "schema_version": 1,
          "issue": 0,
          "branch": "agent/0-short-slug",
          "target_branch": "{{DEFAULT_BRANCH_JSON}}",
          "base_commit": "replace-with-full-commit",
          "owner": "unassigned",
          "role": "writer",
          "status": "draft",
          "scope_globs": ["replace/with/owned/path/**"],
          "shared_paths": [],
          "depends_on": [],
          "validation": ["replace with a real project command"],
          "next_safe_action": "指派一位擁有者、確認無重疊，並選擇工作區隔離方式。"
        }
        -->
    validations:
      required: true
  - type: checkboxes
    id: checks
    attributes:
      label: 指派檢查
      options:
        - label: 已檢查活躍任務和語義合約擁有權的重疊。
          required: true
        - label: 共用路徑有一位整合者或明確的合併順序。
          required: true
        - label: 驗證計畫在不誇大環境或層面的前提下證明此結果。
          required: true
