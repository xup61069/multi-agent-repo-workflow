{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "多代理儲存庫工作流程設定",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_name",
    "mode",
    "task_tracker",
    "default_branch",
    "branch_pattern",
    "handoff_marker",
    "active_statuses",
    "reporting_order",
    "validation",
    "shared_integration_paths"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "project_name": {"type": "string", "minLength": 1},
    "mode": {"enum": ["solo", "adaptive", "strict"]},
    "task_tracker": {"enum": ["github", "manual"]},
    "default_branch": {"type": "string", "minLength": 1},
    "branch_pattern": {"type": "string", "minLength": 1},
    "handoff_marker": {"const": "agent-workflow:handoff-v1"},
    "active_statuses": {
      "type": "array",
      "items": {"enum": ["claimed", "in_review"]},
      "minItems": 1,
      "uniqueItems": true
    },
    "reporting_order": {
      "const": [
        "product_outcome",
        "user_impact",
        "verification",
        "remaining_gaps",
        "development_audit_when_relevant"
      ]
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["always_run", "conditional_gates"],
      "properties": {
        "always_run": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "conditional_gates": {"type": "array", "items": {"type": "object"}}
      }
    },
    "shared_integration_paths": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
